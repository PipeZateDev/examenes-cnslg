{
  "name": "examenes-cnslg",
  "version": "1.0.0",
  "description": "Aplicativo Oficial de Exámenes - Colegio Nuevo San Luis Gonzaga",
  "author": "Colegio Nuevo San Luis Gonzaga",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "setup": "node scripts/setup.js",
    "sync:courses": "node scripts/sync-courses.js",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3001 && electron .\"",
    "electron:build": "electron-builder --win && node scripts/copy-installer.js",
    "electron:start": "electron ."
  },
  "build": {
    "appId": "edu.cnslg.examenes",
    "productName": "Exámenes CNSLG",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asar": true,
    "asarUnpack": [],
    "directories": {
      "output": "C:/Users/Soporte-CNSLG/AppData/Local/Temp/examenes-cnslg-dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Exámenes CNSLG",
      "artifactName": "Examenes CNSLG Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Exámenes CNSLG Portable.${ext}"
    },
    "files": [
      "electron/**/*",
      "public/icon.ico",
      "public/icon.png",
      "public/logo-cnslg.png",
      "package.json",
      "!node_modules/**/*",
      "!**/*.terabox*"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "jose": "^6.0.11",
    "katex": "^0.19.0",
    "mammoth": "^1.9.1",
    "mongodb": "^6.18.0",
    "next": "16.3.8",
    "pdf-parse": "^1.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
